# ── Files that must never be committed to git ─────────────────────────────

# Secrets
.env
.env.*
!.env.example

# Real portfolio data — see config.py's local-override import at the bottom
config_local.py

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Logs
*.log

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Agent tooling. .claude/worktrees/ holds full checkouts of this repo — a
# broad `git add` would otherwise commit a second copy of the tree.
.claude/

# Local database — profile, positions, watchlist, sessions.
# Globbed rather than listed: a dev/scratch database (argus-dev.db, and the
# -wal/-shm SQLite writes beside it) is still a database full of real holdings
# and session hashes, and listing exact names would not cover it.
argus*.db
argus*.db-wal
argus*.db-shm

# graphify's generated AST cache + wiki output — regenerable, and large
# (2.5MB+, grows with every run). Never belongs in the repo or the image.
graphify-out/
