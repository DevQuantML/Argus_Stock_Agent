# ── Copy this file to .env and fill in your values ──────────────────────
# Never commit .env to git — add it to .gitignore

# ── AI research provider ─────────────────────────────────────────────────
# Set ONE of the two below. Perplexity is preferred and used when both are
# present; Groq is the fallback. Without either, the quant engine, charts and
# portfolio P&L still work — only the AI research modules are unavailable.

# Perplexity (primary — sonar-pro, live web search with citations)
# Get from: perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# Groq (fallback — llama-3.3-70b-versatile, fast and free tier, but NO live
# web search, so filings and news fall back to model knowledge. The politician
# -trades module labels itself as unverified when running on Groq.)
# Get from: console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── App auth ─────────────────────────────────────────────────────────────
# A password YOU choose — not a provider key. It gates /api/research/* so
# nobody else can spend your Perplexity credits. Paste this same value into
# the web UI under Settings.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_SECRET=change-me-to-a-strong-random-string

# ── Deployment ───────────────────────────────────────────────────────────
# TRUST_PROXY is a HOP COUNT: how many reverse proxies you control sit in front
# of this app. Not a boolean — though 1 is the common value and means what you
# expect.
#   0 or unset  → no proxy. X-Forwarded-* headers are ignored completely and
#                 only the TCP peer is trusted. Correct for local runs.
#   1           → one proxy. Railway, Fly, Render, and a single nginx are all
#                 this. Correct for a normal cloud deploy.
#   2+          → only if you genuinely chained that many proxies (e.g. a CDN
#                 in front of a platform router).
#
# Getting it wrong breaks the rate limiter in one direction or the other:
#   too low behind a proxy  → every caller collapses into the proxy's single IP
#                             bucket, so one client exhausts the 20 req/min
#                             limit for everybody, including you.
#   too high                → the app reads further left in X-Forwarded-For than
#                             your proxies actually wrote, into the part the
#                             CLIENT supplies. A caller then rotates that value
#                             for a fresh bucket per request and the limiter
#                             never fires.
# Set it to the number of proxies you actually run, and no more.
TRUST_PROXY=

# Override the SQLite path. Defaults to ./argus.db next to store.py. Point this
# at a mounted volume in a container so the book survives a redeploy.
ARGUS_DB=

# Alpha Vantage (optional — yfinance is used by default, no key needed)
# Get from: alphavantage.co/support/#api-key (free tier = 25 calls/day)
ALPHA_VANTAGE_KEY=

# Telegram bot (optional — for push alerts to your phone)
# Get BOT_TOKEN from @BotFather on Telegram
# Get CHAT_ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
